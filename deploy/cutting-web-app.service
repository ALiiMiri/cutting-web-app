[Unit]
Description=Cutting Web App
After=network.target

[Service]
Type=simple
User=cuttingapp
Group=cuttingapp
WorkingDirectory=/opt/cutting-web-app
EnvironmentFile=/etc/cutting-web-app.env
ExecStart=/usr/bin/gunicorn --workers 4 --worker-class sync --timeout 120 --graceful-timeout 30 --max-requests 500 --max-requests-jitter 50 --bind 0.0.0.0:5000 --access-logfile - --error-logfile - cutting_web_app:app
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cutting-app /var/backups/cutting-app /opt/cutting-web-app/static/exports

[Install]
WantedBy=multi-user.target
